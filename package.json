{
  "name": "dsh-effort-tiers",
  "version": "0.1.0",
  "description": "A draggable reasoning-effort slider that replaces the composer's model picker; the top tier turns the track into a drifting cosmic particle field.",
  "license": "MIT",
  "author": "Zhiwei Wang",
  "homepage": "https://github.com/Winjazw/dsh-effort-tiers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Winjazw/dsh-effort-tiers.git"
  },
  "bugs": {
    "url": "https://github.com/Winjazw/dsh-effort-tiers/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "composer",
    "ui"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "screenshots.json",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  }
}
